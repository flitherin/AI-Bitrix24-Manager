# true — бесплатное демо без OpenAI и настоящего Битрикс24.
# В этом режиме нужен только TELEGRAM_BOT_TOKEN; CRM-объекты выводятся в журнал.
DEMO_MODE=false

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:replace_me

# Обязательно при DEMO_MODE=false. В демо-режиме можно оставить пустым.
# Ключ OpenAI или другого OpenAI-совместимого провайдера
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o-mini
# Для OpenAI оставить пустым. Для совместимого API указать, например, https://host/v1
OPENAI_BASE_URL=

# Обязательно при DEMO_MODE=false. В демо-режиме можно оставить пустым.
# Входящий вебхук Битрикс24 с правом CRM (crm).
# Пример: https://example.bitrix24.ru/rest/1/webhook_token/
BITRIX24_WEBHOOK_URL=https://example.bitrix24.ru/rest/1/replace_me/

# auto — ИИ выбирает lead/deal; lead — всегда лид; deal — всегда сделка
BITRIX24_ENTITY_MODE=auto
BITRIX24_DEAL_STAGE=NEW
# ID воронки сделок; оставить пустым для воронки по умолчанию
BITRIX24_DEAL_CATEGORY_ID=
# Необязательный ID источника из справочника Битрикс24
BITRIX24_SOURCE_ID=

DATABASE_PATH=data/bot.db
DIALOGUE_HISTORY_LIMIT=12
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
